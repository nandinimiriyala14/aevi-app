{
  "expo": {
    "name": "Aevi",
    "slug": "aevi-rn",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6F0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF6F0"
      },
      "package": "com.aevi.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aevi.app"
    },
    "extra": {
      "eas": {
        "projectId": "92a9fc99-7733-49c1-9818-4e8869a8f1a4"
      }
    },
    "owner": "nandini14"
  }
}
